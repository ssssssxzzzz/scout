# Slack Socket Mode (prefix ZOOMINFO_BRIEF — set via save-slack-tokens.sh or secret set)
ZOOMINFO_BRIEF_SLACK_BOT_TOKEN=
ZOOMINFO_BRIEF_SLACK_APP_TOKEN=

# --- Channel IDs (Jacob creates channels manually; paste IDs only — never tokens) ---
# Weekday morning digest fallback when Digests-here kv is empty
SCOUT_DIGEST_CHANNEL_ID=
# Optional Slack team id for digest auth context
SCOUT_DIGEST_TEAM_ID=
# Alias for digest channel (same as SCOUT_DIGEST_CHANNEL_ID if both set — digest id wins)
SCOUT_CHANNEL_DIGEST=

# Phase 2 signal lanes (route_lead_alerts). Missing IDs are skipped cleanly — never invent.
# Hot excursions / shutdown / EM excursion lane (HOT_LEADS is Phase 1 alias)
SCOUT_CHANNEL_HOT_EXCURSIONS=
SCOUT_CHANNEL_HOT_LEADS=
# Facility expansion / suite / cleanroom / buyer-adjacent hiring
SCOUT_CHANNEL_FACILITY_EVENTS=
# Lab-landlord / suite moves (Alexandria / Longfellow style)
SCOUT_CHANNEL_LAB_MOVES=
# Weekly brief destination (optional; skip if unset)
SCOUT_CHANNEL_WEEKLY=
# Ops: schedule failures, zero-results, auth errors, daily heartbeat
SCOUT_OPS_CHANNEL_ID=

# Optional scoring overrides (defaults live in config/scoring.yaml)
# SCOUT_SCORE_THRESHOLD=50
# SCOUT_COOLDOWN_DAYS=14
# SCOUT_SCORE_JUMP_REALERT=15
